%% 命令与 __output/ __release/ 的关系 —— wtool-base/README.md §1.3 用
%% 改完跑 .pic/render.sh 重新生成 commands.png
flowchart LR
    SRC["源码 + scripts/"]
    GH(["GitHub Release 发布页"])
    WT["~/.wtool/ → 你的 $HOME"]
    GEN["docs/download.md<br/>scripts/release.json"]

    subgraph PROJ["项目目录（两个都进 .gitignore）"]
        direction LR
        REL["__output/系统_版本/<br/>构建产物（一层一个目录）"]
        PUB["__release/<br/>分卷 + dist.json + hash"]
    end

    SRC -->|"wtool build"| REL
    REL -->|"wtool pack-release"| PUB
    PUB -->|"wtool publish-release"| GH
    GH -.->|"wtool download-release"| PUB
    PUB -.->|"wtool unpack-release"| REL
    REL -->|"wtool install"| WT
    PUB -.->|"顺手写"| GEN
